import cv2
import numpy as np
import matplotlib.pyplot as plt

# ==========================================
# IMAGE SMOOTHING AND SHARPENING
# ==========================================

# STEP 1: IMAGE PATH
image_path = r"C:\Users\balas\OneDrive\Pictures\Hare Krishna.jpeg"

# STEP 2: LOAD IMAGE
image = cv2.imread(image_path)

# Check whether image is loaded
if image is None:
    print("❌ IMAGE NOT FOUND")
    print("Please check the image path:")
    print(image_path)

else:
    print("✅ IMAGE LOADED SUCCESSFULLY")
    print("Image Size:", image.shape)

    # Convert BGR to RGB
    original = cv2.cvtColor(image, cv2.COLOR_BGR2RGB)

    # ==========================================
    # SMOOTHING FILTERS
    # ==========================================

    # 1. Averaging Filter
    average = cv2.blur(image, (5, 5))
    average = cv2.cvtColor(average, cv2.COLOR_BGR2RGB)

    # 2. Gaussian Filter
    gaussian = cv2.GaussianBlur(image, (5, 5), 0)
    gaussian = cv2.cvtColor(gaussian, cv2.COLOR_BGR2RGB)

    # 3. Median Filter
    median = cv2.medianBlur(image, 5)
    median = cv2.cvtColor(median, cv2.COLOR_BGR2RGB)

    # ==========================================
    # SHARPENING FILTER
    # ==========================================

    sharpening_kernel = np.array([
        [0, -1, 0],
        [-1, 5, -1],
        [0, -1, 0]
    ])

    sharpened = cv2.filter2D(image, -1, sharpening_kernel)
    sharpened = cv2.cvtColor(sharpened, cv2.COLOR_BGR2RGB)

    # ==========================================
    # LAPLACIAN FILTER
    # ==========================================

    laplacian = cv2.Laplacian(image, cv2.CV_64F)
    laplacian = cv2.convertScaleAbs(laplacian)
    laplacian = cv2.cvtColor(laplacian, cv2.COLOR_BGR2RGB)

    # ==========================================
    # DISPLAY OUTPUTS
    # ==========================================

    plt.figure(figsize=(15, 10))

    # Original Image
    plt.subplot(2, 3, 1)
    plt.imshow(original)
    plt.title("Original Image")
    plt.axis("off")

    # Averaging Filter
    plt.subplot(2, 3, 2)
    plt.imshow(average)
    plt.title("Averaging Filter")
    plt.axis("off")

    # Gaussian Filter
    plt.subplot(2, 3, 3)
    plt.imshow(gaussian)
    plt.title("Gaussian Filter")
    plt.axis("off")

    # Median Filter
    plt.subplot(2, 3, 4)
    plt.imshow(median)
    plt.title("Median Filter")
    plt.axis("off")

    # Sharpening Filter
    plt.subplot(2, 3, 5)
    plt.imshow(sharpened)
    plt.title("Sharpening Filter")
    plt.axis("off")

    # Laplacian Filter
    plt.subplot(2, 3, 6)
    plt.imshow(laplacian)
    plt.title("Laplacian Filter")
    plt.axis("off")

    # Adjust layout
    plt.tight_layout()

    # Show all images
    plt.show()